# Copy to each immutable release directory as release.env after building this exact image.
PLANKTON_IMAGE_REF=plankton-inference:REPLACE_WITH_RELEASE_ID
PLANKTON_IMAGE_ID=sha256:REPLACE_WITH_64_HEX_CHARACTERS
# Build provenance only; release activation continues to verify PLANKTON_IMAGE_ID.
PLANKTON_RUNTIME_BASE_REF=plankton-inference-runtime:REPLACE_WITH_LOCK_ID
PLANKTON_RUNTIME_BASE_ID=sha256:REPLACE_WITH_64_HEX_CHARACTERS
