[Unit]
Description=Plankton persistent informal demonstration USB
After=local-fs.target
Before=plankton-usb-host.service plankton-informal-demo.service

[Service]
Type=oneshot
RemainAfterExit=yes
RuntimeDirectory=plankton-inference-demo-usb
RuntimeDirectoryMode=0700
ExecStartPre=/bin/sh -c '! /usr/bin/systemctl is-active --quiet plankton-platform.service'
ExecStartPre=/usr/local/sbin/plankton-demo-usb down
ExecStart=/usr/local/sbin/plankton-demo-usb up
ExecStop=/usr/local/sbin/plankton-demo-usb down
TimeoutStartSec=30
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/plankton-inference /run/netns /run/plankton-inference-demo-usb /sys/kernel/config

[Install]
WantedBy=multi-user.target
