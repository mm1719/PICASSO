#!/usr/bin/python3
"""Small GTK askpass dialog for the browserless PICASSO launchers."""

from __future__ import annotations

import os
import sys

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk


def _prompt_and_marker() -> tuple[str, str]:
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    state = os.path.join(runtime_dir, "plankton-picasso-askpass-state")
    if os.path.exists(state):
        prompt = "Incorrect password; please try again."
    else:
        prompt = os.environ.get("SUDO_PROMPT", "Authentication is required to start PICASSO")
        try:
            old_umask = os.umask(0o077)
            try:
                fd = os.open(state, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
                os.close(fd)
            finally:
                os.umask(old_umask)
        except OSError:
            pass
    return prompt, state


def main() -> int:
    prompt, _state = _prompt_and_marker()
    result: list[str] = []

    window = Gtk.Window(title="PICASSO authorization")
    window.set_modal(True)
    window.set_resizable(False)
    window.set_default_size(520, 240)
    window.set_position(Gtk.WindowPosition.CENTER)

    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
    box.set_border_width(24)
    window.add(box)

    label = Gtk.Label(label=prompt)
    label.set_xalign(0.0)
    label.set_line_wrap(True)
    box.pack_start(label, False, False, 0)

    password_label = Gtk.Label(label="Password")
    password_label.set_xalign(0.0)
    box.pack_start(password_label, False, False, 0)

    entry = Gtk.Entry()
    entry.set_visibility(False)
    entry.set_activates_default(True)
    entry.set_hexpand(True)
    entry.set_placeholder_text("Password")
    box.pack_start(entry, False, False, 0)

    buttons = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
    buttons.set_halign(Gtk.Align.END)
    box.pack_end(buttons, False, False, 0)
    cancel = Gtk.Button(label="Cancel")
    ok = Gtk.Button(label="OK")
    ok.set_can_default(True)
    buttons.pack_start(cancel, False, False, 0)
    buttons.pack_start(ok, False, False, 0)
    window.set_default(ok)

    def finish(response: int) -> None:
        if response == 0:
            result.append(entry.get_text())
        Gtk.main_quit()

    ok.connect("clicked", lambda _button: finish(0))
    cancel.connect("clicked", lambda _button: finish(1))
    window.connect("delete-event", lambda *_args: finish(1))
    window.connect("destroy", lambda *_args: Gtk.main_quit())
    window.show_all()
    entry.grab_focus()
    window.present()
    Gtk.main()

    if not result:
        return 1
    sys.stdout.write(result[0] + "\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
