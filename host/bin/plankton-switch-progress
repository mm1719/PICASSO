#!/usr/bin/python3
"""Centered, non-interactive progress window for PICASSO runtime switching."""

from __future__ import annotations

import os
import select
import signal
import sys

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk


def main() -> int:
    if (
        len(sys.argv) != 4
        or sys.argv[2] != "--parent-lifetime-fd"
    ):
        raise SystemExit(
            "usage: plankton-switch-progress [PICASSO|PICASSO Test] "
            "--parent-lifetime-fd FD"
        )
    title = sys.argv[1]
    try:
        parent_fd = int(sys.argv[3])
        os.fstat(parent_fd)
    except (ValueError, OSError) as error:
        raise SystemExit("parent lifetime descriptor is invalid") from error
    if parent_fd < 0:
        raise SystemExit("parent lifetime descriptor is invalid")

    parent_watch = select.poll()
    parent_watch.register(parent_fd, select.POLLIN | select.POLLHUP | select.POLLERR)
    if parent_watch.poll(0):
        os.close(parent_fd)
        return 0

    def parent_closed(_fd: int, _condition: object) -> bool:
        Gtk.main_quit()
        return False

    GLib.io_add_watch(
        parent_fd,
        GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR,
        parent_closed,
    )
    window = Gtk.Window(title=title)
    window.set_modal(True)
    window.set_deletable(False)
    window.set_resizable(False)
    window.set_default_size(520, 180)
    window.set_position(Gtk.WindowPosition.CENTER)
    window.connect("destroy", Gtk.main_quit)

    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
    box.set_border_width(24)
    window.add(box)

    label = Gtk.Label(label=f"Starting {title}; switching runtime...")
    label.set_xalign(0.0)
    label.set_line_wrap(True)
    box.pack_start(label, False, False, 0)

    progress = Gtk.ProgressBar()
    progress.set_pulse_step(0.08)
    box.pack_start(progress, False, False, 0)

    def stop(_signum: int, _frame: object) -> None:
        Gtk.main_quit()

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    window.show_all()
    window.present()
    GLib.timeout_add(100, lambda: (progress.pulse() or True))
    try:
        Gtk.main()
    finally:
        os.close(parent_fd)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
