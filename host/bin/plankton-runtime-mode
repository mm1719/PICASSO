#!/bin/sh
set -eu

release=/opt/plankton-inference/current
platform_env=/etc/plankton-inference/platform.env

usage() {
    echo "usage: plankton-runtime-mode status | pause <reason> | resume <reason>" >&2
    exit 2
}

die() {
    echo "plankton-runtime-mode: $*" >&2
    exit 1
}

command=${1:-}
if [ "$command" = status ]; then
    exec /usr/bin/curl --fail --silent --show-error \
        http://127.0.0.1:${PLANKTON_API_PORT:-8000}/api/v1/runtime
fi

case "$command" in pause|resume) ;; *) usage ;; esac
[ "$#" -ge 2 ] || usage
shift
reason=$(printf '%s' "$*" | /usr/bin/tr '\r\n' '  ')
[ -n "$reason" ] || usage
if [ "$(/usr/bin/id -u)" -ne 0 ]; then
    /usr/bin/logger -t plankton-runtime-mode -- \
        "result=refused action=$command reason=$reason" 2>/dev/null || true
    die "must run as root"
fi
[ -d "$release" ] || die "active release is unavailable: $release"
[ -f "$platform_env" ] || die "platform environment is unavailable: $platform_env"
[ -f "$release/release.env" ] || die "release environment is unavailable"

/usr/bin/logger -t plankton-runtime-mode -- \
    "result=attempted action=$command reason=$reason"
set -a
. "$platform_env"
. "$release/release.env"
set +a
export PLANKTON_ENV_FILE="$platform_env"
if (cd "$release" && /usr/bin/docker compose -f compose.yaml exec -T api \
    python -m plankton_api.admin "$command"); then
    /usr/bin/logger -t plankton-runtime-mode -- \
        "result=completed action=$command reason=$reason"
    exit 0
fi
/usr/bin/logger -t plankton-runtime-mode -- \
    "result=failed action=$command reason=$reason"
die "$command failed"
