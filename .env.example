# Trusted deployment artifact; never point this at USB content.
PLANKTON_IMAGE_REF=plankton-inference:round0-dev
PLANKTON_CHECKPOINT_PATH=/absolute/path/to/approved/best_model.pt
PLANKTON_CHECKPOINT_SHA256=REPLACE_WITH_TRUSTED_CHECKPOINT_SHA256
PLANKTON_TORCH_CACHE_PATH=/var/lib/plankton-inference/torch-cache
PLANKTON_USB_AGENT_SOCKET=/run/plankton-inference/usb-agent.sock
PLANKTON_JOB_ROOT=/var/lib/plankton-inference/jobs
PLANKTON_DATABASE_PATH=/var/lib/plankton-inference/app.db
PLANKTON_GPU_LOCK_PATH=/run/plankton-inference/gpu.lock
PLANKTON_MODEL_NAME=convnextv2_large.fcmae_ft_in22k_in1k
PLANKTON_API_PORT=8000
PLANKTON_HOST_GROUP_ID=REPLACE_WITH_GROUP_GID
PLANKTON_MAX_IMAGE_BYTES=536870912
PLANKTON_MAX_IMAGE_PIXELS=250000000
PLANKTON_DECODE_TIMEOUT_SECONDS=30
# Set after `npm --prefix apps/web run build`; omit during Vite development.
PLANKTON_WEB_DIST=/absolute/path/to/PICASSO/apps/web/dist
PLANKTON_CLAMAV_SIGNATURE_DIR=/var/lib/clamav
PLANKTON_CLAMAV_MAX_SIGNATURE_AGE_HOURS=72
